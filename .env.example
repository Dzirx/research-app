# PostgreSQL (kontener na Mikrusie)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_report

# OpenAI (Whisper + GPT-4o mini)
OPENAI_API_KEY=sk-...

# Anthropic (Claude Sonnet 4.6 — verification)
ANTHROPIC_API_KEY=sk-ant-...

# Apify (Instagram + Facebook scraping)
APIFY_TOKEN=apify_api_...

# SMTP (e-mail delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# Recipient
REPORT_RECIPIENT=client@example.com

# Output directory for PDF
REPORT_OUTPUT_DIR=/home/user/reports
