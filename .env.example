# SQLite (plik lokalny, tworzony automatycznie)
DATABASE_PATH=./db/research.sqlite3

# OpenAI (Whisper + GPT-4o mini: analiza; gpt-5.6-sol: skrypty wideo i fact-check)
OPENAI_API_KEY=sk-...

# Apify (Instagram + Facebook scraping)
APIFY_TOKEN=apify_api_...

# SMTP (e-mail delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# Recipient
REPORT_RECIPIENT=client@example.com

# Output directory for PDF
REPORT_OUTPUT_DIR=/home/user/reports
